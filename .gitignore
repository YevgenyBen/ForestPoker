# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase Admin SDK key (local only)
secrets/*.json

# Firebase local
.firebase/
firebase-debug.log
firestore-debug.log
*-debug.log
.runtimeconfig.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code browser-pane dev server config (local only)
.claude/launch.json
